# Copy this file to backend/.env (setup.sh does it for you) and fill in the two secrets.

# Neon POOLED (PgBouncer, transaction-mode) connection string - host contains "-pooler"
DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini - get a key at https://aistudio.google.com/apikey
# Accessed via Gemini's OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# Minimum spacing between consecutive LLM calls, ms.
# Gemini's free tier allows roughly 10 requests/min for flash models;
# 6000ms is deliberately conservative. Check AI Studio and tune.
LLM_MIN_INTERVAL_MS=6000

# Idle session auto-end (minutes)
SESSION_IDLE_MINUTES=30

# Where generated PDFs are written (served under /static)
EXPORT_DIR=static/exports

# CORS origin for the frontend
FRONTEND_ORIGIN=*
